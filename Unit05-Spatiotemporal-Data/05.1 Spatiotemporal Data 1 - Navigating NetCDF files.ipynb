  {
   "cell_type": "markdown",
   "id": "234aa3dc",
   "metadata": {},
   "source": [
    "### 3. Get the Index Closest to the Mores Creek Snotel Site"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "83251e57",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Closest grid point to Mores Creek Summit:\n",
      "Row: 144, Column: 170\n",
      "Grid Latitude: 43.9362\n",
      "Grid Longitude: -115.6618\n",
      "Distance: 0.0056 degrees\n"
     ]
    }
   ],
   "source": [
    "# Calculate the distance from each grid point to Mores Creek Summit\n",
    "# Using the Euclidean distance as an approximation\n",
    "distance = np.sqrt((wrf_geods['XLAT'][0,:,:].values - mc_lat)**2 + \n",
    "                   (wrf_geods['XLONG'][0,:,:].values - mc_lon)**2)\n",
    "\n",
    "# Find the indices of the minimum distance\n",
    "min_idx = np.unravel_index(np.argmin(distance), distance.shape)\n",
    "row, col = min_idx\n",
    "\n",
    "print(f\"Closest grid point to Mores Creek Summit:\")\n",
    "print(f\"Row: {row}, Column: {col}\")\n",
    "print(f\"Grid Latitude: {wrf_geods['XLAT'][0,row, col]:.4f}\")\n",
    "print(f\"Grid Longitude: {wrf_geods['XLONG'][0,row, col]:.4f}\")\n",
    "print(f\"Distance: {distance[row, col]:.4f} degrees\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "3cb91a9f",
   "metadata": {},
   "source": [
    "### 4. Get Point-scale Time Series Data"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "bbf7e244",
   "metadata": {},
   "outputs": [],
   "source": [
    "mc_dates = wrf_ds['XTIME'][:].values\n",
    "mc_precip = wrf_ds['DPRCP'][:, row, col].values\n",
    "mc_tmean = wrf_ds['TMEAN'][:, row, col].values\n",
    "mc_tmin = wrf_ds['TMIN'][:, row, col].values\n",
    "mc_tmax = wrf_ds['TMAX'][:, row, col].values"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "ac50e057",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1200x800 with 3 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "fig, ax = plt.subplots(2,1, figsize=(12,8), sharex=True)\n",
    "\n",
    "ax[0].bar(mc_dates, mc_precip, width=0.8, color='blue', alpha=0.7)\n",
    "ax[0].set_ylabel('Daily Precipitation (mm)')\n",
    "ax[0].set_title('Daily Precipitation at Mores Creek Summit (WRF Model)')\n",
    "ax_cp = ax[0].twinx()\n",
    "ax_cp.plot(mc_dates, np.cumsum(mc_precip), color='black', label='Cumulative Precipitation')\n",
    "ax_cp.set_ylabel('Cumulative Precipitation (mm)')\n",
    "ax_cp.legend(loc='upper left')\n",
    "ax[1].plot(mc_dates, mc_tmean - 273.15, label='Daily Mean Temp', color='black')\n",
    "ax[1].plot(mc_dates, mc_tmin - 273.15, label='Daily Min. Temp', color='blue', linestyle='--')\n",
    "ax[1].plot(mc_dates, mc_tmax - 273.15, label='Daily Max. Temp', color='red', linestyle='--')\n",
    "ax[1].set_ylabel('Temperature (°C)')\n",
    "ax[1].set_title('Daily Temperatures at Mores Creek Summit (WRF Model)')\n",
    "ax[1].legend()\n",
    "ax[1].grid(axis='y', color='lightgray', linestyle='--', linewidth=0.5)\n",
    "ax[1].set_xlabel('Date')\n",
    "\n",
    "plt.show()"
   ]
  },
